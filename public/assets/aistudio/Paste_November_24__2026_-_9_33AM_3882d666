  const handleImportExistingRirekishoFile = async (e) => {
    const file = e?.target?.files?.[0];
    if (!file || !rirekishoModal) return;
    setIsParsingRirekisho(true);
    setRirekishoStatusBanner({
      type: 'loading',
      text: `⏳ 「${file.name}」を解析して2カラム履歴書へ自動入力しています...`,
    });

    try {
      const lower = file.name.toLowerCase();
      let extracted = {};

      if (lower.endsWith('.xlsx') || lower.endsWith('.xls')) {
        const { XLSX } = await getExcelLibraries();
        const buf = await file.arrayBuffer();
        const wb = XLSX.read(buf, { type: 'array' });
        const allSheetsText = wb.SheetNames.map((sName) => {
          const rows = XLSX.utils.sheet_to_json(wb.Sheets[sName], { header: 1, defval: '' });
          const lines = rows
            .map((r) => r.map((c) => String(c || '').trim()).filter(Boolean).join(' | '))
            .filter(Boolean);
          return `【シート: ${sName}】\n${lines.join('\n')}`;
        }).join('\n\n');

        extracted = await extractRirekishoViaGemini([
          { text: `以下はExcel形式の既存履歴書から抽出した全セル内容です:\n\n${allSheetsText}` },
        ]);
      } else if (lower.endsWith('.docx')) {
        const { JSZip } = await getExcelLibraries();
        const buf = await file.arrayBuffer();
        const zip = await JSZip.loadAsync(buf);
        const docXml = zip.files['word/document.xml']
          ? await zip.files['word/document.xml'].async('string')
          : '';
        const plainWordText = docXml
          .replace(/<\/w:p>/g, '\n')
          .replace(/<\/w:tc>/g, ' | ')
          .replace(/<[^>]+>/g, '')
          .replace(/\n{3,}/g, '\n\n')
          .trim();
        if (!plainWordText) {
          throw new Error('Word文書からテキストを抽出できませんでした');
        }
        extracted = await extractRirekishoViaGemini([
          { text: `以下はWord (.docx) 形式の履歴書内容です:\n\n${plainWordText}` },
        ]);
      } else if (lower.endsWith('.csv') || lower.endsWith('.txt') || file.type.startsWith('text/')) {
        const rawText = await file.text();
        extracted = await extractRirekishoViaGemini([
          { text: `以下はテキスト/CSV形式の履歴書データです:\n\n${rawText}` },
        ]);
      } else if (lower.endsWith('.doc')) {
        throw new Error(
          '旧形式の .doc ファイルは直接読み込めません。.docx または PDF に変換してアップロードしてください。'
        );
      } else {
        // PDF or Image -> Gemini Vision inlineData
        const base64Data = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const res = String(reader.result || '');
            const idx = res.indexOf(',');
            resolve(idx >= 0 ? res.slice(idx + 1) : res);
          };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
        const mimeType =
          file.type || (lower.endsWith('.pdf') ? 'application/pdf' : 'image/png');
        extracted = await extractRirekishoViaGemini([
          { inlineData: { mimeType, data: base64Data } },
        ]);
      }

      const filledCount = applyExtractedRirekishoToDraft(extracted);
      if (filledCount > 0) {
        const msg = `✅ 「${file.name}」から ${filledCount} 項目を抽出し、2カラム履歴書へ自動反映しました！`;
        setRirekishoStatusBanner({ type: 'success', text: msg });
        showToast(msg);
      } else {
        const warnMsg = `⚠️ 「${file.name}」から有効な履歴書項目を検出できませんでした。内容をご確認のうえ手動で補完してください。`;
        setRirekishoStatusBanner({ type: 'error', text: warnMsg });
        showToast(warnMsg);
      }
    } catch (err) {
      console.error('Rirekisho file parse error:', err);
      const errMsg = `❌ 読込エラー：${err?.message || 'ファイル形式を確認してください'}`;
      setRirekishoStatusBanner({ type: 'error', text: errMsg });
      showToast(errMsg);
    } finally {
      setIsParsingRirekisho(false);
      if (e?.target) e.target.value = '';
    }
