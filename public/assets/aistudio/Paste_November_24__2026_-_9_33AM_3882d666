// ============================================================================
// DYNAMIC CDN SCRIPT LOADER FOR XLSX & JSZIP (ZERO-BUNDLER-DEPENDENCY)
// ============================================================================
const loadExternalScript = (src, globalKey) => {
  return new Promise((resolve, reject) => {
    if (typeof window !== 'undefined' && window[globalKey]) {
      resolve(window[globalKey]);
      return;
    }
    const existing = document.querySelector(`script[src="${src}"]`);
    if (existing) {
      existing.addEventListener('load', () => resolve(window[globalKey]));
      existing.addEventListener('error', reject);
      return;
    }
    const script = document.createElement('script');
    script.src = src;
    script.async = true;
    script.onload = () => resolve(window[globalKey]);
    script.onerror = reject;
    document.head.appendChild(script);
  });
};

const getExcelLibraries = async () => {
  const [XLSXLib, JSZipLib] = await Promise.all([
    loadExternalScript(
      'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js',
      'XLSX'
    ),
    loadExternalScript(
      'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js',
      'JSZip'
    ),
  ]);
  return { XLSX: XLSXLib, JSZip: JSZipLib };
};

