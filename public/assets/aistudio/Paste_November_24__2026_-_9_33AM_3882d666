    else setCandidates(updater);
    showToast(`📨 ${person.name} さんに「${companyName}」を提案済みに設定しました`);
  };

  const extractPreferredAreaFromChat = (chatText = '') => {
    const text = String(chatText || '');
    if (!text.trim()) return '';

    const areaPatterns = [
      { rx: /kyoto|京都府|京都/i, label: '京都府（Kyoto）' },
      { rx: /osaka|大阪府|大阪/i, label: '大阪府（Osaka）' },
      { rx: /hyogo|kobe|兵庫県|神戸/i, label: '兵庫県（Hyogo）' },
      { rx: /nara|奈良県|奈良/i, label: '奈良県（Nara）' },
      { rx: /shiga|滋賀県|滋賀/i, label: '滋賀県（Shiga）' },
      { rx: /aichi|nagoya|愛知県|名古屋/i, label: '愛知県（Aichi）' },
      { rx: /shizuoka|静岡県|静岡/i, label: '静岡県（Shizuoka）' },
      { rx: /fukuoka|福岡県|福岡/i, label: '福岡県（Fukuoka）' },
      { rx: /okinawa|沖縄県|沖縄/i, label: '沖縄県（Okinawa）' },
      { rx: /hokkaido|sapporo|北海道|札幌/i, label: '北海道（Hokkaido）' },
      { rx: /miyagi|sendai|宮城県|仙台/i, label: '宮城県（Miyagi）' },
      { rx: /hiroshima|広島県|広島/i, label: '広島県（Hiroshima）' },
      { rx: /kanagawa|yokohama|kawasaki|神奈川県|神奈川|横浜|川崎/i, label: '神奈川県（Kanagawa）' },
      { rx: /saitama|埼玉県|埼玉/i, label: '埼玉県（Saitama）' },
      { rx: /chiba|千葉県|千葉/i, label: '千葉県（Chiba）' },
      { rx: /ibaraki|茨城県|茨城/i, label: '茨城県（Ibaraki）' },
      { rx: /tochigi|栃木県|栃木/i, label: '栃木県（Tochigi）' },
      { rx: /gunma|群馬県|群馬/i, label: '群馬県（Gunma）' },
      { rx: /tokyo|東京都|東京/i, label: '東京都（Tokyo）' },
    ];

    const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
    const wishLineRx = /(?:ở|tại|về|sang|khu vực|tìm.*ở|muốn.*ở|希望|エリア|勤務地|方面|あたり|近く|ないですか|ありますか)/i;

    // 1. Prioritize lines where the candidate explicitly asks or states a preferred location
    for (const line of lines) {
      if (wishLineRx.test(line)) {
        for (const item of areaPatterns) {
          if (item.rx.test(line)) {
            return item.label;
          }
        }
      }
    }

    // 2. Otherwise pick the earliest specific prefecture/city mentioned (preferring non-generic Kanto)
    const found = [];
    for (const item of areaPatterns) {
      const m = text.match(item.rx);
      if (m) {
        found.push({ label: item.label, index: m.index ?? 9999 });
      }
    }
    if (found.length > 0) {
      // If a specific Kansai/regional prefecture like Kyoto/Osaka is mentioned alongside generic Tokyo, prioritize the specific candidate request
      const specificNonTokyo = found.find((f) => !f.label.startsWith('東京都'));
      if (specificNonTokyo && !/東京(?:都|で|に|希望|を探)/.test(text)) {
        return specificNonTokyo.label;
      }
      found.sort((a, b) => a.index - b.index);
      return found[0].label;
    }

    if (/kansai|関西/i.test(text)) return '関西エリア';
    if (/kanto|関東/i.test(text)) return '関東エリア';
    return '';
  };

  const parseChatIntoUpdates = (chatText = '') => {
    const text = String(chatText || '').trim();
    const todayIso = new Date().toISOString().slice(0, 10);
    const updates = { lastContactDate: todayIso };

    const lines = text
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter(Boolean);
    if (lines.length > 0 && lines[0].length <= 40 && !/[:：。]/.test(lines[0])) {
      updates.fbName = lines[0];
      updates.name = lines[0].toUpperCase();
    }

    // 1. Japanese Level (N1 - N5)
    const jlptM = text.match(/\b(N[1-5])\b/i);
    if (jlptM) updates.jlpt = jlptM[1].toUpperCase();

    // 2. Phone & Visa Expiry
    const phoneM = text.match(/(0[789]0[-\s]?\d{4}[-\s]?\d{4})/);
    if (phoneM) updates.phone = phoneM[1];

    const expM = text.match(/(?:在留期限|ビザ期限|hạn visa)[：:\s]*(\d{4}[年\/\-]\d{1,2}[月\/\-]\d{1,2})/i);
    if (expM) updates.visaExpiry = expM[1].replace(/[年月]/g, '-').replace(/日/g, '');

    // 3. Remaining Tokutei Period (e.g., 2,5n / 2.5 năm / 残り2.5年)
    const remPeriodM = text.match(
      /(?:còn|tokutei\s*(?:còn)?|thời hạn\s*(?:còn)?|残り)?\s*(\d+(?:[.,]\d+)?)\s*(?:n\b|năm|年)/i
    );
    if (remPeriodM && /(?:tokutei|特定|còn|残り|visa|ビザ|\d+[.,]\d+\s*n\b)/i.test(text)) {
      const yrs = remPeriodM[1].replace(',', '.');
      updates.visaStatus = `特定技能1号（残り約${yrs}年）`;
    }

    // 4. Industry Detection
    if (/介護|特養|デイサービス|グループホーム|有料老人|shoninsha|初任者|viện de|viện có phí/i.test(text)) {
      updates.desiredIndustry = '介護';
    } else if (/外食|レストラン|居酒屋|キッチン/i.test(text)) {
      updates.desiredIndustry = '外食業';
    } else if (/ドライバー|トラック|運送|運転/i.test(text)) {
      updates.desiredIndustry = '自動車運送業';
    } else if (/ホテル|宿泊|フロント/i.test(text)) {
      updates.desiredIndustry = '宿泊';
    } else if (/食品|弁当|工場/i.test(text)) {
      updates.desiredIndustry = '飲食料品製造業';
    }

    // 5. Preferred Area (Strictly respects specific candidate mentions like Kyoto / 京都)
    const extractedArea = extractPreferredAreaFromChat(text);
    if (extractedArea) {
      updates.desiredArea = extractedArea;
    }

    // 6. Certificates / Passed Exams (e.g., shoninsha / 初任者研修 / 介護福祉士 / 実務者研修)
    const examList = [];
    if (/shoninsha|初任者/i.test(text)) examList.push('介護職員初任者研修修了');
    if (/jitsumusha|実務者/i.test(text)) examList.push('介護福祉士実務者研修修了');
    if (/kaigo fukushishi|介護福祉士/i.test(text)) examList.push('介護福祉士');
    if (/gino|技能評価試験|特定技能試験/i.test(text)) examList.push('特定技能評価試験合格');
    if (examList.length > 0) {
      updates.passedExam = examList.join('・');
    }

    // 7. Work Experience & Facility Types across multiple chat turns (e.g., kn 2 năm, viện de, viện có phí)
    const expParts = [];
    const knMatch = text.match(/(?:kn|kinh nghiệm|経験)\s*(\d+(?:[.,]\d+)?)\s*(?:n\b|năm|年)/i) ||
      text.match(/(\d+(?:[.,]\d+)?)\s*(?:năm|年)\s*(?:kn|kinh nghiệm|経験)/i);
    if (knMatch) {
      expParts.push(`経験${knMatch[1].replace(',', '.')}年`);
    }
    const facilities = [];
    if (/viện\s*de\b|デイサービス|デイ\b/i.test(text)) facilities.push('デイサービス');
    if (/viện\s*có\s*phí|有料老人ホーム|有料/i.test(text)) facilities.push('有料老人ホーム');
    if (/tokuyou|特別養護老人ホーム|特養/i.test(text)) facilities.push('特別養護老人ホーム');
    if (/group\s*home|グループホーム|GH\b/i.test(text)) facilities.push('グループホーム');
    if (/rouken|老健/i.test(text)) facilities.push('老健');
    if (facilities.length > 0) {
      expParts.push(`施設経験：${facilities.join('・')}`);
    }
    if (expParts.length > 0) {
      updates.japanExperience = expParts.join('／');
    }

    // 8. Mendan / Interview Date & Status
    const mendanDateM = text.match(
      /(\d{4}[年\/\-]\d{1,2}[月\/\-]\d{1,2}|\d{1,2}[月\/]\d{1,2}日?)\s*(?:に|の)?\s*(?:面談|面接)/
    );
    if (mendanDateM) {
      const ts = parseFlexibleDateToTimestamp(mendanDateM[1], 2026);
      if (ts > 0) updates.mendanDate = formatTimestampToIso(ts);
    }

    if (/内定/.test(text)) updates.progressStatus = '内定';
    else if (/2次面接/.test(text)) updates.progressStatus = '2次面接予定';
    else if (/1次面接|面接予定|面接決ま/.test(text)) updates.progressStatus = '1次面接予定';
    else if (/面談した|面談済|面談終了/.test(text)) updates.progressStatus = '面談済み';
    else if (/面談調整|日程調整/.test(text)) updates.progressStatus = '面談調整中';

    const compM = text.match(/([^\s、。,\n]+(?:株式会社|有限会社|医療法人|社会福祉法人))/);
    if (compM) updates.proposedCompany = compM[1];

    const structuredNotes = [];
    if (extractedArea) structuredNotes.push(`希望エリア:${extractedArea}`);
    if (expParts.length > 0) structuredNotes.push(expParts.join('・'));
    if (examList.length > 0) structuredNotes.push(`資格:${examList.join('・')}`);
    if (updates.visaStatus) structuredNotes.push(`在留:${updates.visaStatus}`);
    const summaryPrefix = structuredNotes.length > 0 ? `【抽出: ${structuredNotes.join(' / ')}】 ` : '';
    const summarySnippet = text.replace(/\s+/g, ' ').slice(0, 180);
    updates.memoLine = `[${todayIso} チャット更新] ${summaryPrefix}${summarySnippet}`;
    return updates;
  };

  const handleApplyChatToEditingPerson = () => {
    if (!editingPerson || !editChatSnippet.trim()) {
      showToast('⚠️ 新しいチャット内容を入力してください');
      return;
    }
    const extracted = parseChatIntoUpdates(editChatSnippet);
    setEditingPerson((prev) => {
      if (!prev) return prev;
      const d = prev.data;
      const mergedExp = extracted.japanExperience
        ? d.japanExperience && !d.japanExperience.includes(extracted.japanExperience)
          ? `${d.japanExperience} / ${extracted.japanExperience}`
          : extracted.japanExperience
        : d.japanExperience;
      const mergedExam = extracted.passedExam
        ? d.passedExam && !d.passedExam.includes(extracted.passedExam)
          ? `${d.passedExam} / ${extracted.passedExam}`
          : extracted.passedExam
        : d.passedExam;
      return {
        ...prev,
        data: {
          ...d,
          jlpt: extracted.jlpt || d.jlpt,
          phone: extracted.phone || d.phone,
          visaStatus: extracted.visaStatus || d.visaStatus,
          visaExpiry: extracted.visaExpiry || d.visaExpiry,
          desiredIndustry: extracted.desiredIndustry || d.desiredIndustry,
          desiredArea: extracted.desiredArea || d.desiredArea,
          passedExam: mergedExam,
          japanExperience: mergedExp,
          mendanDate: extracted.mendanDate || d.mendanDate,
          progressStatus: extracted.progressStatus || d.progressStatus,
          proposedCompany: extracted.proposedCompany || d.proposedCompany,
          lastContactDate: extracted.lastContactDate || d.lastContactDate,
