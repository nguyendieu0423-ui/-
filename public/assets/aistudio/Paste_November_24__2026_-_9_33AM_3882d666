      )}

      {/* ==================================================================== */}
      {/* MODAL 7: CUSTOM CONFIRMATION DIALOG (FIXED CENTER z-[9999])          */}
      {/* ==================================================================== */}
      {confirmDialog && (
        <div className="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 p-4">
          <div className="w-full max-w-md rounded-2xl bg-white p-5 shadow-2xl">
            <h4 className="text-base font-black text-slate-900">{confirmDialog.title}</h4>
            <p className="mt-2 text-xs leading-relaxed text-slate-600">{confirmDialog.message}</p>
            <div className="mt-4 flex justify-end gap-2">
              <button
                type="button"
                onClick={() => setConfirmDialog(null)}
                className="rounded-xl border border-slate-300 px-4 py-2 text-xs font-bold text-slate-700"
              >
                キャンセル
              </button>
              <button
                type="button"
                onClick={confirmDialog.onConfirm}
                className="rounded-xl bg-rose-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-rose-700"
              >
                削除を実行する
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}