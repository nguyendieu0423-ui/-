                  <div>
                    <div className="mb-2 text-xs font-extrabold text-slate-700">
                      分野別 求人枠数（🟢募集中 / 🎁賞与あり内訳）
                    </div>
                    <div className="space-y-2.5">
                      {kyujinIndustryChartRows.map((row) => {
                        const pct = Math.round((row.total / totalSlotsSafe) * 100);
                        return (
                          <div key={row.industry} className="space-y-1">
                            <div className="flex flex-wrap items-center justify-between gap-1 text-xs">
                              <span className="font-bold text-slate-800">{row.industry}</span>
                              <span className="font-extrabold text-slate-900">
                                計 {row.total}枠（🟢募集 {row.open} / 🎁賞与 {row.bonus}）
                              </span>
                            </div>
                            <div className="h-2.5 w-full overflow-hidden rounded-full bg-slate-100">
                              <div
                                style={{ width: `${Math.max(4, pct)}%` }}
                                className="h-full rounded-full bg-amber-500"
                              />
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </div>

              {/* GAS Sync Configuration Box */}
              <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
                <h3 className="text-sm font-black text-slate-900">
                  ☁️ Google Apps Script (GAS) 連携設定
                </h3>
                <p className="mt-1 text-xs text-slate-500">
                  誤上書き防止のため初期状態は「🔒 GAS上書き保護中」になっています。同期が必要な場合のみヘッダーの保護ボタンを解除して送信してください。
                </p>
                <div className="mt-3 flex flex-wrap items-center gap-2">
                  <input
                    type="text"
                    value={gasWebAppUrl}
                    onChange={(e) => setGasWebAppUrl(e.target.value)}
                    placeholder="https://script.google.com/macros/s/..."
                    className="min-w-[280px] flex-1 rounded-xl border border-slate-300 px-3 py-2 text-xs"
                  />
                  <button
                    type="button"
                    disabled={gasWriteLocked || isSyncingGas}
                    onClick={handleSyncToGas}
                    className="rounded-xl bg-indigo-600 px-4 py-2 text-xs font-extrabold text-white disabled:opacity-50"
                  >
                    {isSyncingGas ? '送信中...' : '☁️ GASへ同期送信'}
                  </button>
                </div>
              </div>
            </div>
          );
        })()}
      </main>

