                      <div className="mt-0.5 text-lg font-black text-amber-900">
                        {kyujinStats.bonusSlots} 枠
                      </div>
                      <div className="text-[10px] font-semibold text-amber-700">
                        {Math.round((kyujinStats.bonusSlots / totalSlotsSafe) * 100)}%
                      </div>
                    </div>
                    <div className="rounded-xl border border-sky-200 bg-sky-50 p-2.5">
                      <div className="text-[11px] font-bold text-sky-800">🏠 寮・社宅あり</div>
                      <div className="mt-0.5 text-lg font-black text-sky-900">
                        {housingAvailableSlots} 枠
                      </div>
                      <div className="text-[10px] font-semibold text-sky-700">
                        {Math.round((housingAvailableSlots / totalSlotsSafe) * 100)}%
                      </div>
