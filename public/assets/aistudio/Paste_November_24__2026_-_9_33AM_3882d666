  const handleImportKyujinFiles = async (e) => {
    const files = Array.from(e?.target?.files || []);
    if (files.length === 0) return;
    setIsImportingKyujin(true);
    const extractedEntries = [];

    try {
      for (const file of files) {
        const lower = file.name.toLowerCase();
        if (lower.endsWith('.xlsx') || lower.endsWith('.xls')) {
          const { XLSX, JSZip } = await getExcelLibraries();
          const buf = await file.arrayBuffer();
          let sheetAnchors = {};
          if (lower.endsWith('.xlsx') && JSZip) {
            try {
              const zip = await JSZip.loadAsync(buf);
              sheetAnchors = await extractExcelCheckedAnchors(zip);
            } catch (_) {}
          }
          const wb = XLSX.read(buf, { type: 'array' });
          wb.SheetNames.forEach((sName, sIdx) => {
            const ws = wb.Sheets[sName];
            const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
            const anchors = sheetAnchors[`sheet${sIdx + 1}`] || [];
            const blocks = splitSheetRowsIntoKyujinBlocks(rows);
            blocks.forEach((blk) => {
              const parsed = parseExcelBlockToKyujin(
                blk.rows,
                sName,
                anchors,
                blk.startRow,
                file.name
              );
              if (parsed) extractedEntries.push(parsed);
            });
          });
        } else {
          // PDF or Image -> Gemini Vision API
          const fallbackComp = file.name
            .replace(/^求人票[_・\-\s]*/i, '')
            .replace(/様.*$/, '')
            .replace(/\.[^.]+$/, '')
            .trim();
          const items = await extractKyujinWithGeminiVision(file);
          items.forEach((parsed, idx) => {
            const cleanArea = formatPublicArea(parsed.area || '');
            const cleanDesc = sanitizeJobDescriptionForCandidate(parsed.jobDescription || '');
            const shiftLabel = String(parsed.shiftTime || '').trim();
            const industry = detectIndustryFromText(
              `${parsed.industry || ''} ${cleanDesc}`,
              `${file.name} ${parsed.industry || ''}`
            );
            const rawJlpt = String(parsed.minJlpt || '').trim();
            const normalizedJlpt = /^(N[1-5]|日常会話|不問)$/.test(rawJlpt)
              ? rawJlpt
              : '要確認';
            const derivedCode =
              String(parsed.jobCode || '').trim() ||
              cleanArea ||
              `${file.name.replace(/\.[^.]+$/, '')}-${idx + 1}`;
            const bonusNorm = normalizeBonusInfo(parsed.bonus, parsed.bonusDetail, cleanDesc);

            extractedEntries.push({
              companyName: String(parsed.companyName || fallbackComp || '新規取込企業')
                .replace(/\s*代表者.*$/, '')
                .trim(),
              industry,
              recruitmentStatus: '募集中',
              slot: {
                slotId: `slot_vis_${Date.now()}_${idx}_${Math.random().toString(36).slice(2, 7)}`,
                industry,
                jobCode: derivedCode,
                area: cleanArea || '勤務地要確認',
                shiftTime: shiftLabel,
                salary: String(parsed.salary || '給与要確認').trim(),
                bonus: bonusNorm.bonus,
                bonusDetail: bonusNorm.bonusDetail,
                minJlpt: normalizedJlpt,
                housingSupport: normalizeHousingDisplay(parsed.housingSupport),
                recruitmentStatus: '募集中',
                careQualification: parsed.careQualification || '',
                jobDescription: cleanDesc,
              },
            });
          });
        }
      }

      if (extractedEntries.length > 0) {
        setKyujins((prev) => {
          const updated = [...prev];
          extractedEntries.forEach((entry) => {
            const existingIdx = updated.findIndex(
              (c) =>
                String(c.companyName || '').replace(/\s+/g, '') ===
                String(entry.companyName || '').replace(/\s+/g, '')
            );
            if (existingIdx >= 0) {
              const target = updated[existingIdx];
              updated[existingIdx] = normalizeKyujinItem({
                ...target,
                areaBreakdown: [...(target.areaBreakdown || []), entry.slot],
              });
            } else {
              updated.unshift(
                normalizeKyujinItem({
                  id: `kj_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,
                  companyName: entry.companyName,
                  industry: entry.industry,
                  recruitmentStatus: '募集中',
                  areaBreakdown: [entry.slot],
                })
              );
            }
          });
          return updated;
        });
        showToast(`✅ ${extractedEntries.length} 件の求人枠を取り込みました`);
      } else {
        showToast('⚠️ 求人データが見つかりませんでした。ファイル形式をご確認ください');
      }
    } catch (err) {
      console.error('Import Kyujin error:', err);
      showToast('⚠️ 取込中にエラーが発生しました');
    } finally {
      setIsImportingKyujin(false);
      if (e?.target) e.target.value = '';
    }
  };

