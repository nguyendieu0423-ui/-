              {mendanInfo.hasMendan && (
                <span className="rounded-full border border-amber-300 bg-amber-50 px-2.5 py-0.5 text-[11px] font-extrabold text-amber-800">
                  🗓️ 面談日：{mendanInfo.dateLabel || '記録あり'}
                </span>
              )}
              {proposedComp && (
                <span className="rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-0.5 text-[11px] font-extrabold text-indigo-800">
                  🏢 提案先：{proposedComp}
                </span>
              )}
            </div>

            {/* Core Profile Pills */}
            <div className="flex flex-wrap items-center gap-1.5 text-xs text-slate-700">
              <span className="rounded bg-slate-100 px-2 py-0.5 font-semibold">
                🌏 {person.nationality || '国籍未設定'}
              </span>
              <span className="rounded bg-indigo-50 px-2 py-0.5 font-bold text-indigo-800">
                🗣️ 日本語：{person.jlpt || '要確認'}
              </span>
              <span className="rounded bg-teal-50 px-2 py-0.5 font-bold text-teal-800">
                🏭 希望：{person.desiredIndustry || '未設定'}
              </span>
              {person.desiredArea && (
                <span className="rounded bg-slate-100 px-2 py-0.5 font-semibold">
                  📍 {person.desiredArea}
                </span>
              )}
              {(person.age || person.birthDate) && (
                <span className="rounded bg-slate-100 px-2 py-0.5 font-semibold">
                  🎂 {person.age ? `${person.age}歳` : person.birthDate}
                </span>
              )}
              {person.visaExpiry && (
                <span className="rounded bg-rose-50 px-2 py-0.5 font-bold text-rose-700">
                  🛂 期限：{person.visaExpiry}
                </span>
              )}
              {person.schoolName && (
                <span className="rounded bg-purple-50 px-2 py-0.5 font-bold text-purple-800">
                  🏫 {person.schoolName}
                </span>
              )}
            </div>
          </div>

          {/* Right Controls: 1-tap Status Dropdown + Modals */}
          <div className="flex flex-wrap items-center gap-1.5">
            <select
              value={person.progressStatus || '新規相談'}
              onChange={(e) => handleQuickStatusChange(person.id, isSchool, e.target.value)}
              title="進捗ステータスを1タップ変更"
              className="rounded-lg border border-indigo-300 bg-indigo-50 px-2.5 py-1.5 text-xs font-extrabold text-indigo-900 shadow-sm"
            >
              {PROGRESS_STATUSES.map((st) => (
                <option key={st} value={st}>
                  📌 {st}
                </option>
              ))}
            </select>

            <button
              type="button"
              onClick={() => handleMarkContactedToday(person, isSchool)}
              className={`rounded-lg px-2.5 py-1.5 text-xs font-extrabold shadow-sm transition ${
                isContactedToday
                  ? 'border border-emerald-300 bg-emerald-100 text-emerald-900'
                  : 'border border-teal-300 bg-teal-50 text-teal-900 hover:bg-teal-100'
              }`}
            >
              {isContactedToday ? `✅ 今日連絡済み (${todayIso})` : '✅ 今日連絡済み'}
            </button>

            <button
              type="button"
              onClick={() =>
                setReplyModal({
                  person,
                  scenario: missingItems.length > 0 ? 'first_mendan' : 'recommend_job',
                })
              }
              className="rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-bold text-white shadow-sm hover:bg-emerald-700"
            >
              💬 返信文提案
            </button>

            <button
              type="button"
              onClick={() => {
                setRirekishoStatusBanner(null);
                setRirekishoChatInput(person.memo || '');
                setRirekishoModal({
                  person,
                  draft: createInitialRirekishoDraft(person),
                });
              }}
              className="rounded-lg bg-indigo-600 px-2.5 py-1.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-700"
            >
              📄 履歴書作成
            </button>

            <button
              type="button"
              onClick={() =>
                setEditingPerson({
                  data: { ...person },
                  isSchool,
                  isNew: false,
                })
              }
              className="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50"
            >
              ✏️ 編集
            </button>

            <button
              type="button"
              onClick={() => handleDeletePerson(person.id, isSchool)}
              className="rounded-lg border border-rose-200 bg-rose-50 px-2 py-1.5 text-xs font-bold text-rose-700 hover:bg-rose-100"
            >
              🗑️
            </button>
          </div>
        </div>

        {/* Missing Information Prompt Bar */}
        {missingItems.length > 0 && (
          <div className="mt-2.5 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-amber-200 bg-amber-50/80 px-3 py-1.5 text-xs">
            <span className="font-bold text-amber-900">
              💡 Cần hỏi thêm ({missingItems.length} mục):{' '}
              <span className="font-semibold text-amber-800">
                {missingItems.map((m) => m.vi).join('、')}
              </span>
            </span>
            <button
              type="button"
              onClick={() => setReplyModal({ person, scenario: 'first_mendan' })}
              className="rounded-md bg-amber-600 px-2.5 py-1 text-[11px] font-extrabold text-white hover:bg-amber-700"
            >
              💬 Tạo câu hỏi ngay
            </button>
          </div>
        )}

        {/* Prominent Decline Reason Banner */}
        {declineReason && (
          <div className="mt-2.5 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-xs">
            <span className="font-black text-rose-900">
              🚫 辞退理由：<span className="font-bold text-rose-800">{declineReason}</span>
            </span>
            <button
              type="button"
              onClick={() =>
                setEditingPerson({
                  data: { ...person },
                  isSchool,
                  isNew: false,
                })
              }
              className="rounded-md border border-rose-300 bg-white px-2 py-0.5 text-[11px] font-bold text-rose-700 hover:bg-rose-100"
            >
              ✏️ 理由を追記・修正
            </button>
          </div>
        )}

        {/* Memo Box */}
        {person.memo && (
          <div className="mt-2.5 whitespace-pre-line rounded-xl bg-slate-50 px-3 py-2 text-xs leading-relaxed text-slate-700">
            {person.memo}
          </div>
        )}

        {/* Recommended Matching Kyujin Block */}
        {matchingKyujins.length > 0 && (
          <div className="mt-3 rounded-xl border border-indigo-100 bg-indigo-50/40 p-2.5">
            <div className="mb-1.5 text-[11px] font-extrabold text-indigo-900">
              🎯 おすすめ求人マッチング（募集中から自動抽出 {matchingKyujins.length}件）
            </div>
            <div className="space-y-1.5">
              {matchingKyujins.map(({ company, slot }) => (
                <div
                  key={slot.slotId}
                  className="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-white bg-white px-2.5 py-1.5 text-xs shadow-xs"
                >
                  <div className="flex flex-wrap items-center gap-1.5">
                    <span className="font-extrabold text-slate-900">
                      {company.companyName}
                    </span>
                    {slot.jobCode && (
                      <span className="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold text-slate-600">
                        #{slot.jobCode}
                      </span>
                    )}
                    <span className="text-slate-600">📍 {formatPublicArea(slot.area)}</span>
                    <span className="font-bold text-emerald-700">💰 {slot.salary}</span>
                    <span className="rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-bold text-indigo-700">
                      🗣️ {slot.minJlpt}
                    </span>
                    {slot.bonus === '賞与あり' && (
                      <span className="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-extrabold text-amber-800">
                        🎁 賞与あり
                      </span>
                    )}
                  </div>
                  <div className="flex items-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => setPreviewModal({ company, slot })}
                      className="rounded-md border border-slate-300 bg-slate-50 px-2 py-1 text-[11px] font-bold text-slate-700 hover:bg-slate-100"
                    >
                      👀 紹介文
                    </button>
                    <button
                      type="button"
                      onClick={() =>
                        handleProposeCompanyToCandidate(person, isSchool, company.companyName)
                      }
                      className="rounded-md bg-indigo-600 px-2 py-1 text-[11px] font-bold text-white hover:bg-indigo-700"
                    >
                      📨 この企業を提案済みにする
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    );
  };

  // ==========================================================================
  // MAIN RENDER
  // ==========================================================================
  return (
    <div className="min-h-screen bg-slate-100 text-slate-900">
      {/* Toast Banner */}
      {toastMsg && (
        <div className="fixed bottom-5 right-5 z-[10000] rounded-xl bg-slate-900 px-4 py-3 text-xs font-extrabold text-white shadow-xl">
          {toastMsg}
        </div>
      )}

      {/* Hidden File Inputs */}
      <input
        ref={backupInputRef}
        type="file"
        accept=".json,application/json"
        onChange={handleImportBackupJson}
        className="hidden"
      />
      <input
        ref={kyujinFileInputRef}
        type="file"
        multiple
        accept=".xlsx,.xls,.pdf,image/*"
        onChange={handleImportKyujinFiles}
        className="hidden"
      />
      <input
        ref={rirekishoFileInputRef}
        type="file"
        accept=".pdf,.xlsx,.xls,.csv,.doc,.docx,image/*"
        onChange={handleImportExistingRirekishoFile}
        className="hidden"
      />

      {/* TOP HEADER BAR */}
      <header className="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div className="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div>
            <div className="flex items-center gap-2">
              <span className="rounded-lg bg-indigo-600 px-2.5 py-1 text-xs font-black text-white">
                TOKUTEI CRM
              </span>
              <h1 className="text-lg font-black tracking-tight text-slate-900">
                特定技能FB相談者管理CRM
              </h1>
            </div>
            <p className="mt-0.5 text-xs font-semibold text-slate-500">
              相談者 {candidates.length} 名（FB個人 {personalCandidates.length} ／ FB会社公式{' '}
              {companyCandidates.length}） ／ 留学生 {schoolStudents.length} 名 ／ 求人{' '}
              {kyujinStats.totalCompanies} 社（{kyujinStats.totalSlots} 枠）
            </p>
          </div>

          {/* Backup / Restore / GAS Protection Controls */}
          <div className="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onClick={handleExportBackupJson}
              className="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-extrabold text-slate-800 shadow-xs hover:bg-slate-50"
            >
              💾 バックアップ保存 (JSON)
            </button>

            <button
              type="button"
              onClick={() => backupInputRef.current?.click()}
              className="rounded-xl border border-indigo-300 bg-indigo-50 px-3 py-2 text-xs font-extrabold text-indigo-800 shadow-xs hover:bg-indigo-100"
            >
              📂 データ復元 (JSON)
            </button>

            <button
              type="button"
              onClick={() => {
                const next = !gasWriteLocked;
                setGasWriteLocked(next);
                showToast(
                  next
                    ? '🔒 GAS上書き保護を有効にしました'
                    : '🔓 GAS上書き保護を解除しました（同期可能）'
                );
              }}
              className={`rounded-xl px-3 py-2 text-xs font-extrabold shadow-xs transition ${
                gasWriteLocked
                  ? 'border border-amber-300 bg-amber-100 text-amber-900'
                  : 'border border-emerald-300 bg-emerald-100 text-emerald-900'
              }`}
            >
              {gasWriteLocked ? '🔒 GAS上書き保護中' : '🔓 GAS同期許可中'}
            </button>
          </div>
        </div>

        {/* MAIN NAVIGATION TABS */}
        <div className="mx-auto max-w-7xl overflow-x-auto px-4 pb-2">
          <div className="flex items-center gap-1.5 whitespace-nowrap">
            {[
              { id: 'all', label: `👥 相談者一覧 (${candidates.length})` },
              { id: 'personal', label: `👤 FB個人 (${personalCandidates.length})` },
              { id: 'company', label: `🏢 FB会社公式 (${companyCandidates.length})` },
              { id: 'school', label: `🎓 日本語学校・留学生 (${schoolStudents.length})` },
              { id: 'mendan', label: `🗓️ 面談・面接管理 (${mendanPeopleSorted.length})` },
              { id: 'proposed', label: `📨 企業提案済み (${allProposedPeople.length})` },
              { id: 'pt', label: `🤝 PT提携・連携管理 (${ptPartners.length})` },
              {
                id: 'kyujin',
                label: `🏭 求人管理・求人票 (${kyujinStats.totalCompanies}社・${kyujinStats.totalSlots}枠)`,
              },
              { id: 'report', label: '📊 データ分析・企業提出用レポート' },
            ].map((tab) => (
              <button
                key={tab.id}
                type="button"
                onClick={() => setActiveTab(tab.id)}
                className={`rounded-xl px-3 py-2 text-xs font-extrabold transition ${
                  activeTab === tab.id
                    ? 'bg-indigo-600 text-white shadow-sm'
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      </header>

      {/* MAIN CONTENT AREA */}
      <main className="mx-auto max-w-7xl px-4 py-4">
        {/* CANDIDATE & STUDENT TABS */}
        {['all', 'personal', 'company', 'school', 'mendan', 'proposed'].includes(activeTab) && (
          <div className="space-y-4">
            {/* Banner 1: Upcoming PV / Mendan Alert */}
            {upcomingMendanAlerts.length > 0 && (
              <div className="rounded-2xl border border-indigo-200 bg-gradient-to-r from-indigo-50 to-sky-50 p-3 shadow-xs">
                <div className="mb-2 flex items-center justify-between">
                  <span className="text-xs font-black text-indigo-950">
                    ⏰ Nhắc lịch PV / Mendan sắp tới（{upcomingMendanAlerts.length}件）
                  </span>
                </div>
                <div className="flex flex-wrap gap-2">
                  {urgentFollowUpList.map(({ person, reason }) => {
                    const isSchool = Boolean(person._isSchool || person.channel === 'school');
                    return (
                      <div
                        key={`urg_${person.id}`}
                        className="flex items-center gap-2 rounded-xl border border-rose-200 bg-white px-3 py-1.5 text-xs"
                      >
                        <span className="font-extrabold text-slate-900">{person.name}</span>
                        <span className="text-[11px] font-bold text-rose-700">({reason})</span>
                        <button
                          type="button"
                          onClick={() =>
                            setReplyModal({ person, scenario: 'followup_silent' })
                          }
                          className="rounded-lg bg-rose-600 px-2 py-1 text-[11px] font-bold text-white hover:bg-rose-700"
                        >
                          💬 Nhắn tin gấp
                        </button>
                        <button
                          type="button"
                          onClick={() => handleMarkContactedToday(person, isSchool)}
                          className="rounded-lg border border-emerald-300 bg-emerald-50 px-2 py-1 text-[11px] font-extrabold text-emerald-800 hover:bg-emerald-100"
                        >
                          ✅ 今日連絡済み
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Banner 2: Urgent Follow-Up Alert */}
            {urgentFollowUpList.length > 0 && (
              <div className="rounded-2xl border border-rose-200 bg-rose-50/80 p-3 shadow-xs">
                <div className="mb-2 flex items-center justify-between">
                  <span className="text-xs font-black text-rose-900">
                    🚨 Cần liên lạc lại gấp（{urgentFollowUpList.length}名）
                  </span>
                  <button
                    type="button"
                    onClick={() =>
                      setCareFilter((prev) => (prev === 'urgent' ? 'all' : 'urgent'))
                    }
                    className="text-[11px] font-extrabold text-rose-700 underline"
                  >
                    {careFilter === 'urgent' ? '解除する' : 'このグループだけ絞り込む →'}
                  </button>
                </div>
                <div className="flex flex-wrap gap-2">
                  {urgentFollowUpList.map(({ person, reason }) => (
                    <div
                      key={`urg_${person.id}`}
                      className="flex items-center gap-2 rounded-xl border border-rose-200 bg-white px-3 py-1.5 text-xs"
                    >
                      <span className="font-extrabold text-slate-900">{person.name}</span>
                      <span className="text-[11px] font-bold text-rose-700">({reason})</span>
                      <button
                        type="button"
                        onClick={() =>
                          setReplyModal({ person, scenario: 'followup_silent' })
                        }
                        className="rounded-lg bg-rose-600 px-2 py-1 text-[11px] font-bold text-white hover:bg-rose-700"
                      >
                        💬 Nhắn tin gấp
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Action & Filter Toolbar */}
            <div className="rounded-2xl border border-slate-200 bg-white p-3.5 shadow-xs space-y-3">
              <div className="flex flex-wrap items-center justify-between gap-2">
                <div className="flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    onClick={() => {
                      setFbChatMode('new');
                      setFbChatChannel(
                        activeTab === 'company'
                          ? 'company'
                          : activeTab === 'school'
                          ? 'school'
                          : 'personal'
                      );
                      setFbChatRawText('');
                      setFbChatModalOpen(true);
                    }}
                    className="rounded-xl bg-sky-600 px-3.5 py-2 text-xs font-extrabold text-white shadow-sm hover:bg-sky-700"
                  >
                    💬 FBチャットから自動登録
                  </button>

                  <button
                    type="button"
                    onClick={() =>
                      setEditingPerson({
                        isSchool: activeTab === 'school',
                        isNew: true,
                        data: {
                          id: `cand_${Date.now()}`,
                          name: '',
                          fbName: '',
                          channel:
                            activeTab === 'company'
                              ? 'company'
                              : activeTab === 'school'
                              ? 'school'
                              : 'personal',
                          nationality: 'ベトナム',
                          gender: '男性',
                          age: '',
                          birthDate: '',
                          jlpt: 'N3',
                          desiredIndustry: '介護',
                          desiredArea: '',
                          visaStatus: '特定技能1号',
                          visaExpiry: '',
                          passedExam: '',
                          japanExperience: '',
                          startDate: '',
                          phone: '',
                          email: '',
                          address: '',
                          progressStatus: '新規相談',
                          proposedCompany: '',
                          mendanDate: '',
                          lastContactDate: new Date().toISOString().slice(0, 10),
                          memo: '',
                        },
                      })
                    }
                    className="rounded-xl bg-indigo-600 px-3.5 py-2 text-xs font-extrabold text-white shadow-sm hover:bg-indigo-700"
                  >
                    ＋ 新規相談者登録
                  </button>
                </div>

                {/* Search & Status Dropdown */}
                <div className="flex flex-wrap items-center gap-2">
                  <input
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder="🔍 氏名・FB名・国籍・希望分野・企業名..."
                    className="w-64 rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold focus:border-indigo-500 focus:outline-none"
                  />
                  <select
                    value={statusFilter}
                    onChange={(e) => setStatusFilter(e.target.value)}
                    className="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700"
                  >
                    <option value="all">📌 すべての進捗</option>
                    {PROGRESS_STATUSES.map((st) => (
                      <option key={st} value={st}>
                        {st}
                      </option>
                    ))}
                  </select>

                  {activeTab === 'proposed' && (
                    <select
                      value={proposedMonthFilter}
                      onChange={(e) => setProposedMonthFilter(e.target.value)}
                      className="rounded-xl border border-indigo-300 bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-800"
                    >
                      <option value="all">📅 提案月（すべて）</option>
                      {proposedMonthOptions.map((m) => (
                        <option key={m} value={m}>
                          {m}
                        </option>
                      ))}
                    </select>
                  )}
                </div>
              </div>

              {/* Quick Care Filter Pills */}
              <div className="flex flex-wrap items-center gap-1.5 border-t border-slate-100 pt-2.5">
                {[
                  { id: 'all', label: 'すべて表示' },
                  { id: 'recent7', label: '🕒 最近対応した人 (7日以内)' },
                  { id: 'scheduled', label: '📅 面談・面接予定あり' },
                  { id: 'recentMendan', label: '🕒 直近の面談（新しい順）' },
                  { id: 'urgent', label: '🚨 要至急フォロー' },
                  { id: 'declined', label: `🚫 辞退者のみ (${declinedPeopleCount})` },
                ].map((pill) => (
                  <button
                    key={pill.id}
                    type="button"
                    onClick={() => setCareFilter(pill.id)}
                    className={`rounded-lg px-3 py-1.5 text-xs font-extrabold transition ${
                      careFilter === pill.id
                        ? pill.id === 'declined'
                          ? 'bg-rose-700 text-white'
                          : 'bg-slate-900 text-white'
                        : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                    }`}
                  >
                    {pill.label}
                  </button>
                ))}

                {careFilter === 'declined' && (
                  <input
                    type="text"
                    value={declineReasonQuery}
                    onChange={(e) => setDeclineReasonQuery(e.target.value)}
                    placeholder="🔍 辞退理由で絞り込み（例：他社決定・給与・エリア・連絡途絶）..."
                    className="ml-1 w-72 rounded-lg border border-rose-300 bg-rose-50/70 px-2.5 py-1 text-xs font-semibold text-rose-950 placeholder:text-rose-400 focus:border-rose-500 focus:outline-none"
                  />
                )}
              </div>

              {/* Proposed Tab Stage Sub-Filter Bar */}
              {activeTab === 'proposed' && (
                <div className="flex flex-wrap items-center gap-1.5 border-t border-indigo-100 bg-indigo-50/50 -mx-3.5 -mb-3.5 rounded-b-2xl px-3.5 py-2.5">
                  <span className="mr-1 text-[11px] font-black text-indigo-950">
                    📨 提案後の進捗ステップ：
                  </span>
                  {[
